# Kumo — anime app for Arch Linux.
#
# Build & install from a checkout of this repository:
#     cd packaging/arch && makepkg -si      (after a git pull: makepkg -sif)
#
# The package is built straight from the checkout two levels up, so local
# changes are picked up without committing them.

pkgname=kumo
pkgver=2.0.0
pkgrel=1
pkgdesc="Anime library: AniList sync, auto matching, mpv & in-app player, ani-cli sub/dub streaming, torrents, extensions"
arch=('x86_64' 'aarch64')
url="https://github.com/v0-0x/kumo-anime"
license=('GPL-3.0-or-later')
depends=('electron' 'mpv' 'ffmpeg' 'hicolor-icon-theme' 'xdg-utils')
makedepends=('go' 'nodejs' 'npm')
optdepends=(
    'ani-cli: sub/dub online streaming and downloads (AUR)'
    'yt-dlp: faster, more reliable stream downloads'
    'qbittorrent: torrent client (enable Tools › Options › Web UI)'
    'transmission-gtk: alternative torrent client'
    'discord: rich presence'
)
options=('!lto' '!debug' '!strip' '!buildflags') # pure Go (CGO off): makepkg's C/LD flags don't apply
install=kumo.install

_root="$(realpath "${startdir}/../..")"

# The version and commit go into the server, which compares them with
# GitHub's to offer updates (Home page). Kumo's updater builds a downloaded
# source, which has no .git: it passes them in KUMO_COMMIT and KUMO_VERSION.
# In a git checkout they come from git (version 2.0.<commits since 2.0.0's>,
# see desktop/package.json); otherwise, e.g. in an extracted source zip, the
# defaults stay. pkgver stays as it is on purpose: a pkgver() function would
# make makepkg rewrite this file in your checkout, and git pull would then
# stop on it.
build() {
    cd "${_root}"
    export GOFLAGS="-trimpath -mod=readonly -modcacherw"
    export CGO_ENABLED=0
    local commit="${KUMO_COMMIT:-}" version="${KUMO_VERSION:-}" count
    if [[ ! -e "${_root}/.git" ]]; then
        # Not a checkout: Go mustn't stamp a git repository it's inside of
        # (e.g. a home folder kept in git).
        GOFLAGS+=" -buildvcs=false"
    elif command -v git >/dev/null; then
        [[ -n ${commit} ]] || commit="$(git -C "${_root}" rev-parse HEAD 2>/dev/null)" || commit=""
        if [[ -z ${version} ]] && count="$(git -C "${_root}" rev-list --count HEAD 2>/dev/null)"; then
            # Major.minor from desktop/package.json, and the commits since
            # the one its kumoVersionBase counts (2.0.0's).
            local pkg="${_root}/desktop/package.json" mm from
            mm="$(sed -n 's/^ *"version": *"\([0-9]*\.[0-9]*\)\..*/\1/p' "${pkg}")"
            from="$(sed -n 's/^ *"kumoVersionBase": *\([0-9]*\).*/\1/p' "${pkg}")"
            version="${mm:-1.0}.$((count - ${from:-0}))"
        fi
    fi
    local config=github.com/simo1337s/animetest/server/internal/config
    local ldflags="-s -w"
    [[ -z ${commit} ]] || ldflags+=" -X ${config}.Commit=${commit}"
    [[ -z ${version} ]] || ldflags+=" -X ${config}.AppVersion=${version}"
    make server GO_LDFLAGS="${ldflags}"
}

# The quick tests (Kumo's own updater skips them: --nocheck): the file name
# parser, ani-cli's driver, extensions, sharing between Kumos, the watch
# history they exchange, and the updater.
check() {
    cd "${_root}/server"
    go test ./internal/library/ ./internal/anicli/ ./internal/extensions/ ./internal/share/ ./internal/history/ ./internal/update/
}

package() {
    cd "${_root}"
    install -Dm755 dist/kumo "${pkgdir}/usr/lib/kumo/kumo"
    install -Dm644 desktop/main.js "${pkgdir}/usr/lib/kumo/app/main.js"
    install -Dm644 desktop/preload.js "${pkgdir}/usr/lib/kumo/app/preload.js"
    install -Dm644 desktop/package.json "${pkgdir}/usr/lib/kumo/app/package.json"
    install -Dm644 packaging/icons/kumo-512.png "${pkgdir}/usr/lib/kumo/app/icon.png"

    install -Dm755 packaging/kumo.sh "${pkgdir}/usr/bin/kumo"
    install -d "${pkgdir}/usr/bin"
    ln -s /usr/lib/kumo/kumo "${pkgdir}/usr/bin/kumo-server"

    install -Dm644 packaging/kumo.desktop "${pkgdir}/usr/share/applications/kumo.desktop"
    # The icon, by two names: kumo-anime, the menu entry's since the new logo
    # (desktops cache icons by name, and kept showing the old one), and
    # kumo, which desktop shortcuts made before ask for (the app moves them
    # to kumo-anime when it starts).
    local s n
    for n in kumo-anime kumo; do
        for s in 16 32 48 64 128 256 512; do
            install -Dm644 "packaging/icons/kumo-${s}.png" "${pkgdir}/usr/share/icons/hicolor/${s}x${s}/apps/${n}.png"
        done
        install -Dm644 packaging/icons/kumo.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/${n}.svg"
    done
    install -Dm644 packaging/kumo-server.service "${pkgdir}/usr/lib/systemd/user/kumo-server.service"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
