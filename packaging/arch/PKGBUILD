# Aniko — anime app for Arch Linux.
#
# Build & install from a checkout of this repository:
#     cd packaging/arch && makepkg -si      (after a git pull: makepkg -sif)
#
# The package is built straight from the checkout two levels up, so local
# changes are picked up without committing them.

# Aniko was called Kumo before 2.0.37. Kumo's own updater (2.0.36 and older)
# builds this with KUMO_COMMIT set and installs the package named kumo-*:
# built that way, the package keeps the old name (with Aniko in it), and
# Aniko's updater swaps it for the aniko package later. Otherwise the aniko
# package takes kumo's place (pacman asks to remove kumo).
if [[ -n ${KUMO_COMMIT:-} && -z ${ANIKO_COMMIT:-} ]]; then
    pkgname=kumo
else
    pkgname=aniko
    provides=('kumo')
    conflicts=('kumo')
    replaces=('kumo')
fi
pkgver=2.0.0
pkgrel=1
pkgdesc="Anime library: AniList sync, auto matching, mpv & in-app player, ani-cli sub/dub streaming, torrents, extensions"
arch=('x86_64' 'aarch64')
url="https://github.com/v0-0x/kumo-anime"
license=('GPL-3.0-or-later')
depends=('electron' 'mpv' 'ffmpeg' 'hicolor-icon-theme' 'xdg-utils')
makedepends=('go' 'nodejs' 'npm')
optdepends=(
    'ani-cli: sub/dub online streaming and downloads (AUR)'
    'yt-dlp: faster, more reliable stream downloads'
    'qbittorrent: torrent client (enable Tools › Options › Web UI)'
    'transmission-gtk: alternative torrent client'
    'discord: rich presence'
)
options=('!lto' '!debug' '!strip' '!buildflags') # pure Go (CGO off): makepkg's C/LD flags don't apply
install=aniko.install

_root="$(realpath "${startdir}/../..")"

# The version and commit go into the server, which compares them with
# GitHub's to offer updates (Home page). Aniko's updater builds a downloaded
# source, which has no .git: it passes them in ANIKO_COMMIT and ANIKO_VERSION.
# In a git checkout they come from git (version 2.0.<commits since 2.0.0's>,
# see desktop/package.json); otherwise, e.g. in an extracted source zip, the
# defaults stay. pkgver stays as it is on purpose: a pkgver() function would
# make makepkg rewrite this file in your checkout, and git pull would then
# stop on it.
build() {
    cd "${_root}"
    export GOFLAGS="-trimpath -mod=readonly -modcacherw"
    export CGO_ENABLED=0
    local commit="${ANIKO_COMMIT:-${KUMO_COMMIT:-}}" version="${ANIKO_VERSION:-${KUMO_VERSION:-}}" count
    if [[ ! -e "${_root}/.git" ]]; then
        # Not a checkout: Go mustn't stamp a git repository it's inside of
        # (e.g. a home folder kept in git).
        GOFLAGS+=" -buildvcs=false"
    elif command -v git >/dev/null; then
        [[ -n ${commit} ]] || commit="$(git -C "${_root}" rev-parse HEAD 2>/dev/null)" || commit=""
        if [[ -z ${version} ]] && count="$(git -C "${_root}" rev-list --count HEAD 2>/dev/null)"; then
            # Major.minor from desktop/package.json, and the commits since
            # the one its anikoVersionBase counts (2.0.0's).
            local pkg="${_root}/desktop/package.json" mm from
            mm="$(sed -n 's/^ *"version": *"\([0-9]*\.[0-9]*\)\..*/\1/p' "${pkg}")"
            from="$(sed -n 's/^ *"anikoVersionBase": *\([0-9]*\).*/\1/p' "${pkg}")"
            version="${mm:-1.0}.$((count - ${from:-0}))"
        fi
    fi
    local config=github.com/simo1337s/animetest/server/internal/config
    local ldflags="-s -w"
    [[ -z ${commit} ]] || ldflags+=" -X ${config}.Commit=${commit}"
    [[ -z ${version} ]] || ldflags+=" -X ${config}.AppVersion=${version}"
    make server GO_LDFLAGS="${ldflags}"
}

# The quick tests (Aniko's own updater skips them: --nocheck): the file name
# parser, ani-cli's driver, extensions, sharing between Anikos, the watch
# history they exchange, and the updater.
check() {
    cd "${_root}/server"
    go test ./internal/library/ ./internal/anicli/ ./internal/extensions/ ./internal/share/ ./internal/history/ ./internal/update/
}

package() {
    cd "${_root}"
    install -Dm755 dist/aniko "${pkgdir}/usr/lib/aniko/aniko"
    install -Dm644 desktop/main.js "${pkgdir}/usr/lib/aniko/app/main.js"
    install -Dm644 desktop/preload.js "${pkgdir}/usr/lib/aniko/app/preload.js"
    install -Dm644 desktop/package.json "${pkgdir}/usr/lib/aniko/app/package.json"
    install -Dm644 packaging/icons/aniko-512.png "${pkgdir}/usr/lib/aniko/app/icon.png"

    install -Dm755 packaging/aniko.sh "${pkgdir}/usr/bin/aniko"
    install -d "${pkgdir}/usr/bin"
    ln -s /usr/lib/aniko/aniko "${pkgdir}/usr/bin/aniko-server"
    # The old names, for what was set up before the rename: the menu entry
    # and autostart a desktop made (the app moves them to aniko when it
    # opens) and a running Kumo restarting into the update.
    ln -s aniko "${pkgdir}/usr/bin/kumo"
    ln -s aniko "${pkgdir}/usr/lib/kumo"

    install -Dm644 packaging/aniko.desktop "${pkgdir}/usr/share/applications/aniko.desktop"
    local s
    for s in 16 32 48 64 128 256 512; do
        install -Dm644 "packaging/icons/aniko-${s}.png" "${pkgdir}/usr/share/icons/hicolor/${s}x${s}/apps/aniko.png"
    done
    install -Dm644 packaging/icons/aniko.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/aniko.svg"
    install -Dm644 packaging/aniko-server.service "${pkgdir}/usr/lib/systemd/user/aniko-server.service"
    # Its name before the rename, for a kumo-server turned on back then (a
    # link: systemd takes it as another name for aniko-server).
    ln -s aniko-server.service "${pkgdir}/usr/lib/systemd/user/kumo-server.service"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
